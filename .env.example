# SmartPocket Environment Configuration
# Copy this file to .env for local overrides if needed.
# Note: SmartPocket is designed to run completely offline with client-side state
# and local storage persistence. No proprietary secret keys are required.

VITE_APP_TITLE="SmartPocket"
VITE_APP_ENV="development"
VITE_DEFAULT_CURRENCY="INR"
VITE_CURRENCY_SYMBOL="₹"
